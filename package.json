{
    "name": "audiojones.com",
    "version": "0.1.0",
    "packageManager": "pnpm@10.30.3",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "pnpm packages:build && next build",
        "start": "next start",
        "lint": "eslint",
        "packages:build": "pnpm -r --filter='@aj/*' build",
        "packages:dev": "pnpm -r --filter='@aj/*' dev",
        "imagekit:convert": "node scripts/convert-to-ikimage.js",
        "imagekit:setup": "node scripts/setup-imagekit.js",
        "repo:init": "node tools/repo.js init",
        "repo:link": "node tools/repo.js link",
        "repo:sync": "node tools/repo.js sync",
        "repo:status": "node tools/repo.js status",
        "repo:commit": "node tools/repo.js commit",
        "lint:api-imports": "eslint \"src/app/api/**/route.ts\"",
        "typecheck": "tsc --noEmit",
        "check:no-firebase": "tsx scripts/check-no-firebase.ts",
        "vercel:patch-win": "powershell -ExecutionPolicy Bypass -File scripts/patch-vercel-next-win.ps1",
        "build:prod": "pnpm vercel:patch-win && npx vercel build --prod",
        "deploy:prod": "pnpm vercel:patch-win && npx vercel --prod",
        "release:check": "bash scripts/release-check.sh"
    },
    "dependencies": {
        "@aj/config": "workspace:*",
        "@neondatabase/neon-js": "0.2.0-beta.1",
        "@neondatabase/serverless": "^1.0.0",
        "clsx": "^2.1.1",
        "groq": "^5.23.0",
        "imagekit": "^6.0.0",
        "lucide-react": "^0.546.0",
        "next": "16.2.3",
        "next-sanity": "^12.4.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "remark": "^15.0.1",
        "remark-html": "^16.0.1",
        "resend": "^4.6.0",
        "server-only": "^0.0.1",
        "stripe": "^19.1.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/node-fetch": "^2.6.13",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^17.2.3",
        "eslint": "^9",
        "eslint-config-next": "16.0.0",
        "glob": "^11.0.3",
        "jscodeshift": "^17.3.0",
        "node-fetch": "^3.3.2",
        "sharp": "^0.34.4",
        "sharp-cli": "^5.2.0",
        "tailwindcss": "^4",
        "tsx": "^4.20.6",
        "typescript": "^5",
        "vercel": "48.9.0"
    },
    "description": "Public marketing site for AJ Digital LLC (audiojones.com): Founder Intelligence System positioning, AI Readiness Diagnostic, lead capture, and booking. Next.js 16 + React 19 + TypeScript on Vercel; Sanity CMS, NeonDB, Resend, n8n, Stripe.",
    "main": "index.js",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AJDIGITALllc/audiojones.com.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/AJDIGITALllc/audiojones.com/issues"
    },
    "homepage": "https://github.com/AJDIGITALllc/audiojones.com#readme",
    "pnpm": {
        "overrides": {
            "fast-xml-parser": ">=4.5.4",
            "better-auth": ">=1.4.9",
            "protobufjs": ">=7.5.5",
            "glob": ">=11.1.0",
            "node-forge": ">=1.3.2",
            "jws": ">=4.0.1",
            "tar": ">=7.5.7",
            "fastify": ">=5.7.2",
            "axios": ">=1.13.5",
            "minimatch@9": ">=9.0.7",
            "minimatch@10": ">=10.2.3",
            "flatted": ">=3.4.2",
            "picomatch": ">=4.0.4",
            "path-to-regexp": ">=8.4.0",
            "lodash": ">=4.18.0",
            "@isaacs/brace-expansion": ">=5.0.1",
            "eslint-plugin-react-hooks>zod": "^4.0.0"
        }
    }
}
