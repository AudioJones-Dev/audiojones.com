# Core app environment
NODE_ENV=
NEXT_PUBLIC_SITE_URL=

# Admin API authentication.
# Required by /api/admin/* routes (see src/lib/server/requireAdmin.ts).
# Never expose this as NEXT_PUBLIC_* — it must stay server-side only.
# Portal admin UI does NOT need this in the browser; the server-side proxy
# at /api/_proxy/admin/[...path] injects it after verifying the admin session.
ADMIN_KEY=

# Database — NeonDB (Postgres). Source of truth for leads + structured data.
# See db/migrations/ for schema.
DATABASE_URL=

# Whop integration
WHOP_API_KEY=
NEXT_PUBLIC_WHOP_APP_ID=
NEXT_PUBLIC_WHOP_COMPANY_ID=
NEXT_PUBLIC_WHOP_AGENT_USER_ID=
WHOP_WEBHOOK_SECRET=

# OpenAI & AI services
OPENAI_API_KEY=

# MailerLite integration. MAILERLITE_TOKEN is the only key name the app reads;
# see NEWSLETTER_PROVIDER below.
MAILERLITE_TOKEN=
MAILERLITE_GROUP_ID=

# Email — Resend (lead notifications, transactional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
FROM_EMAIL=

# n8n automation (optional). Lead capture continues if n8n fails.
N8N_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Applied Intelligence diagnostic
# Persistence + notification env is shared with the canonical lead pipeline:
#   DATABASE_URL, RESEND_API_KEY, LEAD_NOTIFICATION_EMAIL, FROM_EMAIL,
#   N8N_LEAD_WEBHOOK_URL or CRM_WEBHOOK_URL (optional), IP_HASH_SALT (optional).
# See docs/DEPLOYMENT.md §9 for the preview QA checklist.
LEAD_FORM_SECRET=
IP_HASH_SALT=

# Sanity CMS — blog / topic cluster content
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run without Sanity (blog shows empty state).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# Supabase — only used if auth, storage, or realtime is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ImageKit CDN
IMAGEKIT_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Observability & monitoring
LOG_LEVEL=
SENTRY_DSN=
RELEASE=

# API base URLs
API_BASE_URL=
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------
# Wave 1 / dev-mode integration switches.
# These let you run the UI locally without live integration tokens.
# Locally, all values are optional and the defaults are safe (mock adapters,
# disabled). On a deployed environment, LEAD_FORM_PROVIDER and
# NEWSLETTER_PROVIDER have no safe default; see each below.
# ---------------------------------------------------------------

# Lead-form provider switch for /apply. There is no safe default: on any
# deployed environment, leaving this unset REJECTS submissions (500
# PROVIDER_ERROR). Set "neon" in production.
#   "neon"   — persist to applied_intelligence_leads on NeonDB. Requires
#              DATABASE_URL and db/migrations/003_apply_submission_fields.sql
#              to be applied first. If DATABASE_URL is unset the endpoint
#              REJECTS submissions rather than falling back to mock — a smoke
#              test against a half-configured deploy is expected to fail, and
#              that failure is the intended signal.
#   "mock"   — log to console, return synthetic success. No persistence.
#              Allowed locally and on previews, where naming it is a
#              deliberate choice. REFUSED in production.
#   "resend" — historical value that never persisted anything. No longer an
#              alias for "mock": it is unrecognised, so it rejects like any
#              other unusable value. Set "neon".
#
# Nothing may answer a successful submission without a persisted row. An
# unset or unrecognised provider used to fall through to mock, which on
# 2026-09-10 discarded every production application behind a success page.
LEAD_FORM_PROVIDER=

# Force-disable optional integrations regardless of token presence.
# Useful for browser/Storybook/E2E sessions where you want the
# UI to render the "pending" state instead of attempting a request.
NEXT_PUBLIC_MAILERLITE_DISABLED=
NEXT_PUBLIC_IMAGEKIT_DISABLED=
NEXT_PUBLIC_OPENAI_DISABLED=

# Newsletter provider switch for /api/newsletter, the footer form on every
# page. There is no safe default: on any deployed environment, leaving this
# unset REJECTS subscriptions (500 PROVIDER_ERROR). Use "neon" once
# db/migrations/005_newsletter_subscribers.sql is applied; "mailerlite" until
# then.
#   "neon"       — save the address to newsletter_subscribers on NeonDB and
#                  answer success once the row exists. Then send it to
#                  MailerLite (as "mailerlite" does) after the response, and
#                  record the outcome on the row: synced, failed, or skipped
#                  when MAILERLITE_TOKEN is unset. A MailerLite failure does not
#                  lose the signup. Requires DATABASE_URL, and migration 005
#                  applied FIRST. If DATABASE_URL is unset the endpoint REJECTS
#                  subscriptions rather than falling back to mock. DATABASE_URL
#                  alone does not select this provider.
#   "mailerlite" — POST to MailerLite (MAILERLITE_API_BASE, default
#                  connect.mailerlite.com) with MAILERLITE_TOKEN, adding the
#                  subscriber to MAILERLITE_GROUP_ID when set. If the token is
#                  unset, or MailerLite answers non-2xx or cannot be reached,
#                  the endpoint REJECTS the subscription rather than falling
#                  back to mock. Nothing is saved on our side.
#   "mock"       — log a redacted payload, return a synthetic id. Nothing is
#                  stored. Allowed locally and on previews, where naming it is
#                  a deliberate choice. REFUSED in production.
#                  NEXT_PUBLIC_MAILERLITE_DISABLED=true is treated the same.
#
# Nothing may answer a successful subscription unless the address was saved
# (neon) or MailerLite accepted it (mailerlite).
# Every failure used to fall back to mock and show "Subscribed.", and the key
# had two names: runtime read MAILERLITE_TOKEN while the env schema and
# scripts/verify-integrations.ts checked MAILERLITE_API_KEY. It is now
# MAILERLITE_TOKEN everywhere.
NEWSLETTER_PROVIDER=

# Optional ImageKit hero overlay path. If set, the homepage hero's
# right-pane SVG will composite this image as an aria-hidden overlay.
# Leave empty to ship the pure code-rendered hero.
NEXT_PUBLIC_IK_HERO_OVERLAY=
