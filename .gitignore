# Local CLI capture output and dev scratch (never commit).
# Caught a bunch of these in the W1.6 sweep — preventing recurrence.
.firecrawl/
*_out.txt
*_err.txt
_tmp_*
deploy.bat
deploy*.bat

# generated by scripts/validate-local.ts
/validation-summary.json

# Visual QA harness output (screenshots, manifests, reviews — never commit)
artifacts/visual-qa/
